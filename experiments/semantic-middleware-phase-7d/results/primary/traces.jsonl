{"sampleHash":"bdcfebc7344672996da6eb7dd44d2bcbed20f3d19c88d59f37585ec067173560","itemId":"B001","cohort":"B","trace":{"traceVersion":"unda-semantic-shadow-trace-v1","purpose":"evaluationOnly","runId":"d85f8f58-7fd4-47a8-9310-e98639bc3a17","timestamp":"2026-10-06T03:10:11.517Z","linkage":{"workflowRunId":"1588c602-4784-4927-87bc-54ea58189997","reviewRunId":"phase7d:9d1e5acd7430fee473d611e248f4f1f7a6560b1260c5745a8fc5ca760ff4ac93","postKey":"p3","channel":"instagram","surface":"caption","committedStep":"offlineFrozenEvaluation","safetyReviewer":{"promptVersion":"unavailable-original-safety","outcome":null},"consolidatedReviewer":{"outcome":{"summary":"სამივე პოსტი შეესაბამება ამოცანას, ფორმატსა და შეზღუდვებს; საჯარო ფაქტების ან დაუდასტურებელი შედეგების მტკიცება არ იკვეთება.","issues":[{"message":"ავტომატიზაციის შეფასება ტექნოლოგიის არჩევით არ იწყება. — Instagram-ის ერთადერთ კადრში დაამატეთ დასრულებული ვიზუალური ტექსტი და სქემა: სათაური, პროცესი–მონაცემი–კონტროლის სამკუთხედი და დიაგნოზზე გადასვლის დასკვნა. Caption დატოვეთ დამხმარე განმარტებად და არა კადრის შემცვლელად.","postKey":"p3","severity":"blocking"},{"message":"თუ ეს სამი ნაწილი გაურკვეველია, AI პროცესს ვერ დააზუსტებს — მხოლოდ არსებულ გაურკვევლობას გადაიტანს ახალ სისტემაში. — Instagram-ის ერთ კადრში მკაფიო იერარქიით დაალაგეთ სამი წინაპირობა — პროცესი, მონაცემი, კონტროლი — და მათ ქვემოთ მოათავსეთ დიაგნოზის დასკვნა, რათა გრაფიკამ დამოუკიდებლად შეასრულოს მითითებული framePlan.","postKey":"p3","severity":"blocking"}]}}},"source":{"sourceId":"weekly_post_batches:1588c602-4784-4927-87bc-54ea58189997/repairDraft/p3/instagram/caption","revisionId":"1258317dbbe07ff32dc7d692eb7487c3625109909de2bd800e04ab34aed966ca","text":"ავტომატიზაციის შეფასება ტექნოლოგიის არჩევით არ იწყება.\n\nჯერ უნდა განისაზღვროს:\n— რომელი განმეორებადი პროცესი გვინდა შევცვალოთ;\n— რა სანდო მონაცემი იწვევს გადაწყვეტილებას ან მოქმედებას;\n— ვინ რჩება პასუხისმგებელი და სად არის ადამიანური კონტროლის წერტილი.\n\nთუ ეს სამი ნაწილი გაურკვეველია, AI პროცესს ვერ დააზუსტებს — მხოლოდ არსებულ გაურკვევლობას გადაიტანს ახალ სისტემაში.\n\nAI შეიძლება იყოს კულისებში მოქმედი ფუნქციური ფენა. არა მომხმარებლისთვის საჩვენებელი ეფექტი და არა ადამიანური პასუხისმგებლობის შემცვლელი.\n\nამიტომ პირველი ნაბიჯი ავტომატიზაცია კი არა, პროცესის დიაგნოზია."},"eligibility":"ineligible","invocation":"notInvoked","requestedTargets":[],"candidates":{"bindings":[]},"decisions":[],"unresolvedFields":[],"contractValidation":{"status":"notChecked","issues":[]},"knownCapabilityLimits":[],"technicalErrors":[],"latencyMs":null,"providerRequests":0,"semanticDecisions":0,"tokens":{"input":null,"output":null},"costUsd":null,"configuration":{"provider":"jev","executionMode":"provider","protocolVersion":"unda-semantic-shadow-jev-bounded-v1","model":"jev-1.13.0","timeoutMs":2000,"budgetMs":5000,"maxTasks":5,"policy":{"mode":"rawOnly"},"configurationRef":"semantic-shadow-config:631dd6e42d2bdc27acae"},"actualModel":null,"costEstimateRates":{"inputUsdPerMillion":0.042,"outputUsdPerMillion":0},"notInvokedReason":"noBoundedAnchor"}}
