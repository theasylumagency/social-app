# Test deployments must explicitly opt into simulated subscription checkout. No bank is contacted.
BILLING_MODE=simulated

DATABASE_URL=postgresql://unda_social:replace-with-a-local-password@127.0.0.1:5433/unda_social
POSTGRES_USER=unda_social
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=unda_social
OPENAI_PLANNING_MODEL=gpt-5.6-terra
OPENAI_POST_PLANNER_MODEL=gpt-5.6-terra
OPENAI_POST_WRITER_MODEL=gpt-5.6-sol
OPENAI_POST_REVIEW_MODEL=gpt-5.6-terra
OPENAI_BRAND_MODEL=gpt-5.6-terra
OPENAI_API_KEY=
# Per-stage reasoning: low, medium, high. Unset values retain low.
# Pilot based on the controlled gpt-6.1-sol comparison; re-evaluate on live workloads.
OPENAI_POST_PLANNER_REASONING_EFFORT=medium
OPENAI_POST_WRITER_REASONING_EFFORT=medium
OPENAI_POST_REVIEW_REASONING_EFFORT=low
OPENAI_STRATEGY_REASONING_EFFORT=low
# Visuals: development/demo/test grant 20 credits once per workspace.
# Production grants none. An explicit demo mode also works in a production build.
# Leave empty to follow NODE_ENV (unknown environments default to production).
VISUAL_MODE=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=medium
OPENAI_EXTRACTION_MODEL=gpt-5.4-nano
OPENAI_EXTRACTION_FALLBACK_MODEL=gpt-5.6-terra
# Optional contextual notes override; otherwise uses OPENAI_BRAND_MODEL.
OPENAI_CONTEXTUAL_NOTES_MODEL=
# Voice input: both provider and model are required. No silent fallback.
# Providers: openai, openai-compatible, elevenlabs. OpenAI uses OPENAI_API_KEY.
SPEECH_TO_TEXT_PROVIDER=openai
SPEECH_TO_TEXT_MODEL=gpt-4o-mini-transcribe
# For openai-compatible only: exact HTTPS transcription endpoint and its key.
SPEECH_TO_TEXT_ENDPOINT=
SPEECH_TO_TEXT_API_KEY=
# For elevenlabs: set SPEECH_TO_TEXT_PROVIDER=elevenlabs and SPEECH_TO_TEXT_MODEL=scribe_v2.
# The default endpoint is https://api.elevenlabs.io/v1/speech-to-text; SPEECH_TO_TEXT_ENDPOINT may override it.
ELEVENLABS_API_KEY=

# Authentication. Generate a unique random secret of at least 32 characters.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Comma-separated, case-insensitive allowlist for the internal Operations Console.
UNDA_ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; GitHub appears only when both values are configured.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email delivery modes: "resend" (recommended), "preview" (local files in .local/auth-mail), or "smtp"
# For production (app.unda.pro), set AUTH_EMAIL_MODE=resend with RESEND_API_KEY.
AUTH_EMAIL_MODE=preview
RESEND_API_KEY=
RESEND_FROM=UNDA <noreply@unda.pro>

# Fallback SMTP settings (used only if AUTH_EMAIL_MODE=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Phase 2 connections need the API key and context key below. Publishing stays off.
SOCIAL_PUBLISHING_ENABLED=false
SOCIAL_PUBLISH_MAX_ATTEMPTS=3
SOCIAL_PUBLISH_ATTEMPT_GRACE_SECONDS=120
ZERNIO_API_BASE_URL=https://zernio.com/api/v1
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=
# Base64-encoded 32 random bytes for encrypted, short-lived connection context.
# Keep server-only; preserve across restarts. Rotation invalidates open connections.
SOCIAL_CONNECTION_CONTEXT_KEY=
SOCIAL_ANALYTICS_ENABLED=false
SOCIAL_ANALYTICS_POLL_SECONDS=900

# Phase 7C evaluation only. Disabled by default; never used for application decisions.
SEMANTIC_MIDDLEWARE_SHADOW_ENABLED=false
SEMANTIC_MIDDLEWARE_SHADOW_PROVIDER=jev
SEMANTIC_MIDDLEWARE_SHADOW_MODEL=jev-1.13.0
SEMANTIC_MIDDLEWARE_SHADOW_JEV_API_KEY=
SEMANTIC_MIDDLEWARE_SHADOW_TRACE_PATH=.local/semantic-shadow/worker.jsonl
SEMANTIC_MIDDLEWARE_SHADOW_TIMEOUT_MS=1000
SEMANTIC_MIDDLEWARE_SHADOW_BUDGET_MS=2500
SEMANTIC_MIDDLEWARE_SHADOW_MAX_TASKS=3
# Empty means raw probabilities only. Both bounds + an experiment reference are required.
# These are shadow-analysis metadata, never production thresholds.
SEMANTIC_MIDDLEWARE_SHADOW_EXPERIMENT_LOW=
SEMANTIC_MIDDLEWARE_SHADOW_EXPERIMENT_HIGH=
SEMANTIC_MIDDLEWARE_SHADOW_EXPERIMENT_REF=
# Optional token-based cost estimates; do not guess account-specific rates.
SEMANTIC_MIDDLEWARE_SHADOW_INPUT_USD_PER_M=
SEMANTIC_MIDDLEWARE_SHADOW_OUTPUT_USD_PER_M=

# Independent operator loops. Queue concurrency applies to each of four AI families.
# Run worker:operator -- --role=ai|delivery|analytics for separate managed processes.
OPERATOR_QUEUE_CONCURRENCY=2
OPERATOR_POLL_INTERVAL_MS=3000
OPERATOR_AI_DATABASE_POOL_MAX=10
OPERATOR_DELIVERY_DATABASE_POOL_MAX=4
OPERATOR_ANALYTICS_DATABASE_POOL_MAX=2
