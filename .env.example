# Test deployments must explicitly opt into simulated subscription checkout. No bank is contacted.
BILLING_MODE=simulated

DATABASE_URL=postgresql://unda_social:replace-with-a-local-password@127.0.0.1:5433/unda_social
POSTGRES_USER=unda_social
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=unda_social
OPENAI_PLANNING_MODEL=gpt-5.6-terra
OPENAI_POST_PLANNER_MODEL=gpt-5.6-terra
OPENAI_POST_WRITER_MODEL=gpt-5.6-sol
OPENAI_POST_REVIEW_MODEL=gpt-5.6-terra
OPENAI_BRAND_MODEL=gpt-5.6-terra
OPENAI_API_KEY=
# Visuals: development/demo/test grant 20 credits once per workspace.
# Production grants none. An explicit demo mode also works in a production build.
# Leave empty to follow NODE_ENV (unknown environments default to production).
VISUAL_MODE=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=medium
OPENAI_EXTRACTION_MODEL=gpt-5.4-nano
OPENAI_EXTRACTION_FALLBACK_MODEL=gpt-5.6-terra

# Authentication. Generate a unique random secret of at least 32 characters.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; GitHub appears only when both values are configured.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email delivery modes: "resend" (recommended), "preview" (local files in .local/auth-mail), or "smtp"
# For production (app.unda.pro), set AUTH_EMAIL_MODE=resend with RESEND_API_KEY.
AUTH_EMAIL_MODE=preview
RESEND_API_KEY=
RESEND_FROM=UNDA <noreply@unda.pro>

# Fallback SMTP settings (used only if AUTH_EMAIL_MODE=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Phase 2 connections need the API key and context key below. Publishing stays off.
SOCIAL_PUBLISHING_ENABLED=false
SOCIAL_PUBLISH_MAX_ATTEMPTS=3
SOCIAL_PUBLISH_ATTEMPT_GRACE_SECONDS=120
ZERNIO_API_BASE_URL=https://zernio.com/api/v1
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=
# Base64-encoded 32 random bytes for encrypted, short-lived connection context.
# Keep server-only; preserve across restarts. Rotation invalidates open connections.
SOCIAL_CONNECTION_CONTEXT_KEY=
SOCIAL_ANALYTICS_ENABLED=false
SOCIAL_ANALYTICS_POLL_SECONDS=900
