{
  "name": "unda-social-operator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:domain": "tsc -p tsconfig.domain-build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file=.env.local scripts/db/migrate.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run check && npm run build:domain && node --test tests/primitives.runtime.test.cjs tests/social-blueprint.runtime.test.cjs tests/weekly-plan.runtime.test.cjs tests/content-brief.runtime.test.cjs tests/content-draft-quality.runtime.test.cjs tests/content-draft-validation.runtime.test.cjs",
    "test:dashboard": "node --env-file=.env.local --import tsx --test tests/dashboard.integration.test.mts",
    "test:integration": "npm run build:domain && npm run db:migrate && node --env-file=.env.local --test tests/postgres.integration.test.cjs",
    "test:auth": "node --env-file=.env.local --import tsx --test tests/auth.integration.test.mts",
    "auth:init-local": "node scripts/auth/init-local.mjs",
    "eval:golden": "node --env-file=.env.local --import tsx evals/golden/cli.ts",
    "eval:golden:profile": "node --env-file=.env.local --import tsx evals/golden/communication-profile-cli.ts",
    "eval:golden:envelope": "node --env-file=.env.local --import tsx evals/golden/communication-envelope-cli.ts",
    "eval:golden:weekly-focus": "node --env-file=.env.local --import tsx evals/golden/weekly-audience-focus-cli.ts",
    "eval:golden:content-audience": "node --env-file=.env.local --import tsx evals/golden/content-audience-direction-cli.ts",
    "eval:golden:weekly-objective": "node --env-file=.env.local --import tsx evals/golden/weekly-objective-cli.ts",
    "eval:golden:content-direction": "node --env-file=.env.local --import tsx evals/golden/content-direction-cli.ts",
    "eval:golden:experiment": "node --env-file=.env.local --import tsx evals/golden/experiment-decision-cli.ts",
    "eval:golden:content-brief": "node --env-file=.env.local --import tsx evals/golden/content-brief-cli.ts",
    "eval:golden:execution-spec": "node --env-file=.env.local --import tsx evals/golden/content-execution-spec-cli.ts",
    "eval:golden:writer": "node --env-file=.env.local --import tsx evals/golden/content-writer-cli.ts",
    "verify": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "better-auth": "^1.7.2",
    "cheerio": "^1.2.0",
    "next": "16.3.4",
    "nodemailer": "^10.0.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.26.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}