{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "declaration": true,
    "declarationMap": true,
    "incremental": false,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true
  },
  "include": [
    "src/core/**/*.ts",
    "src/blueprints/social/**/*.ts",
    "src/application/**/*.ts",
    "src/infrastructure/**/*.ts"
  ],
  "exclude": ["node_modules", "tests"]
}
